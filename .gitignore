# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distributions / packaging
*.egg
*.egg-info/
.eggs/
build/
develop-eggs/
sdist/
wheels/
share/python-wheels/

# ── Virtual environments ──────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── PyInstaller ───────────────────────────────────────────────────────────
# Build intermediates (regenerable). PyInstaller raw outputs and the final
# exe/GcodeSimV1.exe are kept out of git — they're 100+ MB, exceed GitHub's
# per-file limit, and rebuild deterministically from source via build.bat
# (or `pyinstaller pyinstaller.spec`). The viewer .exe is published via
# GitHub Releases; the editor binary (exe/gcodegenV1.0.exe) is small enough
# to track directly.
gcode_viewer_v2/build/
gcode_viewer_v2/dist/
exe/GcodeSimV1.exe

# ── Go (gcode_viewer_v3) ──────────────────────────────────────────────────
# Build artifacts. The Go binaries rebuild quickly from source on each
# platform — no point checking the platform-specific outputs into git.
gcode_viewer_v3/gcodesim
gcode_viewer_v3/gcodesim.exe
gcode_viewer_v3/gcodesim-arm64
gcode_viewer_v3/gcodesim-amd64
gcode_viewer_v3/GcodeSimV3.app/
gcode_viewer_v3/GcodeSimV3.app.zip
gcode_viewer_v3/icon.icns

# Compiled binaries anywhere — but keep the small bundled editor exe.
*.exe
!exe/gcodegenV1.0.exe
*.app/

# Go module artifacts (not the lockfile go.sum, which we DO commit)
gcode_viewer_v3/vendor/

# Generated Windows resource files (icon + version info embedding). Built
# from versioninfo.json + icon.ico by `goversioninfo`; rebuilt on every
# `build.ps1` run, deterministic from inputs.
*.syso

# ── IDE / editor noise ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Test / coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Local secrets / configs ───────────────────────────────────────────────
.env
.env.local
*.local

# ── Claude Code / agent files ─────────────────────────────────────────────
# .claude/ holds local agent state and is per-machine
.claude/
